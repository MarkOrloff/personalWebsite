---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperReader from '../../components/PaperReader.astro';
import PeerPlot from '../../components/PeerPlot.astro';
import ValueMap from '../../components/ValueMap.astro';
import OdorMap from '../../components/OdorMap.astro';
import RestMap from '../../components/RestMap.astro';
import { paperStories } from '../../data/paper-stories';
import { withPublicationCopy } from '../../lib/publication-copy';
import { getEntry } from 'astro:content';
export function getStaticPaths() { return paperStories.map(story=>({params:{slug:story.slug},props:{story}})); }
const { story } = Astro.props;
const publication = await getEntry('publications', story.entry);
if (!publication) throw new Error(`Missing publication: ${story.entry}`);
---
<BaseLayout title={story.title} description={story.deck}>
  <PaperReader story={story} paper={withPublicationCopy(publication).data}>
    {story.slug==='safer-peers' && <PeerPlot slot="figure" />}
    {story.slug==='subjective-value' && <ValueMap slot="figure" />}
    {story.slug==='smell-and-space' && <OdorMap slot="figure" />}
    {story.slug==='maps-at-rest' && <RestMap slot="figure" />}
  </PaperReader>
</BaseLayout>
