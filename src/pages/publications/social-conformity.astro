---
import '../../styles/publication-reader.css';
import { copy } from '../../lib/site-copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrainEvidence from '../../components/BrainEvidence.astro';
import SocialPlot from '../../components/SocialPlot.astro';
import { excitement, steps } from '../../data/social-conformity-story';
import { withPublicationCopy } from '../../lib/publication-copy';
import { getEntry } from 'astro:content';
const publication = await getEntry('publications', '2024-orloff-et-al-ploscompbio');
const paper = withPublicationCopy(publication!).data;
---
<BaseLayout title={copy("social-conformity.page.title")} description={copy("ui.social-conformity.a-guided-look-at-social-conformity")}>
  <article class="publication-reader preserve-case" data-reader data-paper="social-conformity">
    <header class="reader-header">
      <a class="back-link text-link" href="/publications">{copy("ui.paper-reader.all-publications")}</a>
      <p class="eyebrow">{copy("ui.social-conformity.a-study-in-social-decision-making")}</p>
      <h1>{copy('social-conformity.page.title')}</h1>
      <p class="reader-deck">{copy('social-conformity.page.deck')}</p>
    </header>
    <div class="reader-toolbar" hidden data-enhanced>
      <div class="depth-tabs" role="tablist" aria-label={copy("ui.paper-reader.reading-depth")}>
        <button type="button" role="tab" id="depth-gist" aria-controls="panel-gist" aria-selected="true" data-depth="gist">{copy("ui.paper-reader.the-gist")} <span>{copy("ui.paper-reader.30-seconds")}</span></button>
        <button type="button" role="tab" id="depth-story" aria-controls="panel-story" aria-selected="false" tabindex="-1" data-depth="story">{copy("ui.paper-reader.walk-me-through-it")} <span>{copy("ui.paper-reader.3-minutes")}</span></button>
        <button type="button" role="tab" id="depth-deep" aria-controls="panel-deep" aria-selected="false" tabindex="-1" data-depth="deep">{copy("ui.paper-reader.go-deeper")} <span>{copy("ui.paper-reader.another-layer")}</span></button>
      </div>
      <button class="share-button" type="button" data-share>{copy("ui.paper-reader.copy-reading-link")}</button>
      <p class="share-status sr-only" role="status"></p>
      <label class="share-fallback" hidden>{copy("ui.paper-reader.reading-link")} <input readonly aria-label={copy("ui.paper-reader.reading-link")} /></label>
    </div>
    <div class="reader-body">
      <div class="reader-narrative">
        <section id="panel-gist" role="tabpanel" aria-labelledby="depth-gist" data-depth-panel="gist">
          <p class="section-label">{copy("ui.paper-reader.the-short-version")}</p>
          <h2>{copy('social-conformity.page.gist-title')}</h2>
          <p>{copy('social-conformity.page.gist-1')}</p>
          <p>{copy('social-conformity.page.gist-2')}</p>
          <button type="button" class="reader-cta" data-start-story hidden data-enhanced>{copy("ui.social-conformity.help-me-read-this-graph")} <span aria-hidden="true">→</span></button>
          <p class="small-note">{copy('social-conformity.page.gist-caveat')}</p>
        </section>
        <section id="panel-story" role="tabpanel" aria-labelledby="depth-story" data-depth-panel="story">
          <div class="story-copy preserve-case" aria-live="polite" aria-atomic="true">
            {steps.map((step, index) => <div data-step-panel={index} data-view={step.view} data-emphasis={step.emphasis} data-visual={index===0?'brain':'plot'}><h2 class="sr-only">{step.title}</h2><p>{step.text}</p><p>{step.more}</p><p class="step-hint">{step.hint}</p></div>)}
          </div>
        </section>
        <section id="panel-deep" role="tabpanel" aria-labelledby="depth-deep" data-depth-panel="deep">
          <p class="section-label">{copy("ui.social-conformity.behind-the-figure")}</p>
          <h2>{copy('social-conformity.page.deep-title')}</h2>
          <p>{copy('social-conformity.page.deep-1')}</p>
          <p>{copy('social-conformity.page.deep-2')}</p>
          <dl class="findings">
            <div><dt>{copy("ui.social-conformity.combined-lesion-groups-vs-comparison")}</dt><dd class="preserve-case">{copy("ui.social-conformity.p-0-014")}</dd></div>
            <div><dt>{copy("ui.social-conformity.insula-vs-comparison")}</dt><dd class="preserve-case">{copy("ui.social-conformity.p-0-036")}</dd></div>
            <div><dt><span class="preserve-case">{copy("ui.social-plot.dacc")}</span> {copy("ui.social-conformity.vs-comparison")}</dt><dd class="preserve-case">{copy("ui.social-conformity.p-0-025")}</dd></div>
            <div><dt>{copy("ui.social-conformity.solo-mismatch-following-all-participants")}</dt><dd class="preserve-case">{copy("ui.social-conformity.r-0-52-p-2-7")}<sup>−4</sup></dd></div>
          </dl>
          <p class="small-note">{copy('social-conformity.page.deep-method')}</p>
          <details><summary>{copy("ui.social-conformity.see-the-original-figure-panel")}</summary><figure class="original-figure"><div class="paper-figure-frame"><img src="/pubs/2024-orloff-et-al-ploscompbio.jpg" width="811" height="1052" loading="lazy" alt={copy("ui.social-conformity.original-figure-3a-following-weight-estimates")} /></div><figcaption>{copy("ui.social-conformity.figure-3a")} <span class="preserve-case">{copy("ui.social-plot.orloff-et-al-2024")}</span> · <a class="text-link" href="https://creativecommons.org/licenses/by/4.0/">{copy("ui.social-conformity.cc-by")}</a></figcaption></figure></details>
          <a class="arrow-link" href={`https://doi.org/${paper.doi}`}>{copy("ui.social-conformity.read-the-full-paper")} <span aria-hidden="true">↗</span></a>
        </section>
      </div>
      <div class="reader-figure"><div data-reader-plot><SocialPlot id="reader-plot" /></div><div data-reader-brain><BrainEvidence slug="social-conformity" compact /></div></div>
      <div class="story-pagination" hidden data-enhanced><button class="quiet-button" type="button" data-step-previous disabled>{copy("ui.paper-reader.back")}</button><span class="eyebrow" data-step-count></span><button class="quiet-button" type="button" data-step-next>{copy("ui.paper-reader.next")}</button></div>
    </div>
    <aside class="author-note">
      <div><p class="section-label">{copy("subjective-value.takeawayTitle")}</p><p class="note-byline">{copy("ui.social-conformity.a-note-from")} <span class="preserve-case">{copy("ui.about.mark")}</span></p></div>
      <div><p class="excitement-copy">{excitement}</p><p class="small-note">{copy('social-conformity.page.takeaway-caveat')}</p></div>
    </aside>
    <footer class="paper-reference">
      <p class="section-label">{copy("ui.social-conformity.the-paper")}</p>
      <div><p class="citation-title preserve-case">{paper.title}</p><p class="citation-authors preserve-case">{paper.authors.join(', ')}.</p><p class="preserve-case muted">{paper.venue} · {paper.year} {copy("ui.paper-reader.equal-contribution")}</p><div class="reference-links"><a class="text-link" href={`https://doi.org/${paper.doi}`}>{copy("ui.social-conformity.paper")}</a><a class="text-link" href="https://code.vt.edu/maorloff/insula-lesions-and-social-heuristic">{copy("ui.social-plot.data-code")}</a><a class="text-link" href="https://creativecommons.org/licenses/by/4.0/">{copy("ui.social-conformity.figure-data-attribution-cc-by")}</a></div></div>
    </footer>
  </article>
</BaseLayout>
<script>
  import '../../scripts/publication-reader';
</script>
