---
import { copy } from "../lib/site-copy.mjs";
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withPublicationCopy } from '../lib/publication-copy';
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
const pubs = (await getCollection('publications')).map(withPublicationCopy).sort((a,b) => Number(b.data.year || 0) - Number(a.data.year || 0));
---
<BaseLayout title={copy("ui.navigation.publications")} description={copy("ui.publications.description")}>
  <header class="page-intro"><h1>{copy("ui.publications.publications")}</h1><p>{copy("ui.publications.intro")}</p></header>
  <a class="reader-invitation" href="/publications/subjective-value"><div><p class="section-label">{copy("ui.publications.new")} <span class="preserve-case">{copy("ui.publications.biorxiv")}</span> {copy("ui.publications.preprint")}</p><h2>{copy("subjective-value.title")}</h2><p>{copy("ui.publications.feature-invite")}</p></div><span aria-hidden="true">→</span></a>
  <div class="publication-tools"><div class="filters" role="group" aria-label={copy("ui.publications.filter-publications")} hidden data-pub-filters><button type="button" data-filter="all" aria-pressed="true">{copy("ui.publications.all-work")} <span>{pubs.length}</span></button><button type="button" data-filter="article" aria-pressed="false">{copy("ui.publications.studies")} <span>{pubs.filter(p => p.data.type === 'article').length}</span></button><button type="button" data-filter="commentary" aria-pressed="false">{copy("ui.publications.commentaries")} <span>{pubs.filter(p => p.data.type === 'commentary').length}</span></button></div><a class="scholar-link" href={SITE.social.googleScholar} aria-label={copy("ui.footer.google-scholar")} title={copy("ui.footer.google-scholar")}><Icon name="google-scholar" size={25} /></a></div>
  <p class="sr-only" data-filter-status role="status"></p>
  <ol class="publication-list">
    {pubs.map(({data}) => <li data-publication-type={data.type || 'article'}><article class="publication-row"><div class="publication-year"><span>{data.year}</span><span class="eyebrow">{copy(data.status==='preprint'?"label.preprint":data.type==='commentary'?"label.commentary":"label.study")}</span></div><div class="publication-copy"><p class="eyebrow">{data.venue}</p><h2><a href={data.walkthrough || `https://doi.org/${data.doi}`}>{data.title}</a></h2><p class="pub-authors preserve-case">{data.authors.join(', ')}</p><p class="pub-summary preserve-case">{data.summary}</p><div class="pub-links">{data.walkthrough && <a class="text-link" href={data.walkthrough}>{copy("ui.publications.walk-through-it")}</a>}<a class="text-link" href={data.doi ? `https://doi.org/${data.doi}` : data.url}>{copy("ui.publications.read")} {copy(data.status==='preprint'?"label.preprint":data.type==='commentary'?"label.commentary":"label.paper")} ↗</a></div></div>{data.figure && <a class="pub-figure paper-figure-frame" href={data.walkthrough || `https://doi.org/${data.doi}`} aria-label={copy("ui.publications.figure-for-value", { value1: data.title })}><img src={data.figure} alt={data.figureAlt || ''} width={data.figureWidth} height={data.figureHeight} loading="lazy" /></a>}</article></li>)}
  </ol>
  <p class="equal-note">{copy("ui.publications.equal-contribution")}</p>
</BaseLayout>
<script>import { copy } from "../lib/site-copy.mjs";

  const filters = document.querySelector<HTMLElement>('[data-pub-filters]');
  if (filters) {
    filters.hidden = false;
    filters.addEventListener('click', event => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;
      const filter = button.dataset.filter;
      let visible = 0;
      document.querySelectorAll<HTMLElement>('[data-publication-type]').forEach(row => { row.hidden = filter !== 'all' && row.dataset.publicationType !== filter; if (!row.hidden) visible++; });
      filters.querySelectorAll('button').forEach(el => el.setAttribute('aria-pressed', String(el === button)));
      document.querySelector('[data-filter-status]')!.textContent = copy("ui.publications.value-publications-shown", { value1: visible });
    });
  }
</script>
<style>
  .reader-invitation { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 28px 0; border-block: 1px solid var(--color-line); margin-bottom: 38px; }
  .reader-invitation h2 { font-family: var(--font-editorial); font-size: clamp(28px,3.4vw,40px); margin: 16px 0 10px; }
  .reader-invitation p:last-child { color: var(--color-muted); font-size: 14px; margin: 0; }
  .reader-invitation > span { color: var(--color-accent); font-size: 36px; }
  .publication-tools { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 18px; margin-bottom: 16px; font-size: 12px; }
  .filters { display: flex; gap: 20px; }
  .filters button { background: none; border: 0; border-bottom: 1px solid transparent; min-height: 44px; padding: 8px 0; font-size: 13px; color: var(--color-muted); }
  .filters button span { font: 10px var(--font-mono); margin-left: 6px; }
  .filters button[aria-pressed="true"] { color: var(--color-fg); border-bottom-color: var(--color-accent-2); }
  .publication-list { list-style: none; margin: 0; padding: 0; }
  .publication-row { display: grid; grid-template-columns: 80px minmax(0,1fr) 320px; gap: 28px; border-top: 1px solid var(--color-line); padding: 34px 0; align-items: start; }
  .publication-year { font: 20px/1.5 var(--font-editorial); color: var(--color-accent-2); }
  .publication-year .eyebrow { display: block; margin-top: 8px; font-size: 9px; }
  .publication-copy > .eyebrow { margin-bottom: 12px; }
  .publication-copy h2 { font: 400 clamp(22px,2.5vw,29px)/1.23 var(--font-editorial); letter-spacing: -.025em; margin-bottom: 15px; }
  .pub-authors { font-size: 11px; color: var(--color-muted); }
  .pub-summary { font-size: 14px; margin: 18px 0; color: var(--color-muted); }
  .pub-links { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 12px; }
  .pub-links a { min-height: 44px; display: inline-flex; align-items: center; }
  .pub-figure { align-self: center; display: block; }
  .pub-figure img { width: 100%; height: 230px; object-fit: contain; }
  .equal-note { font-size: 11px; color: var(--color-muted); border-top: 1px solid var(--color-line); padding-top: 20px; }
  @media (max-width: 900px) { .publication-row { grid-template-columns: 55px minmax(0,1fr) 220px; gap: 20px; } }
  @media (max-width: 640px) { .publication-row { grid-template-columns: 1fr; gap: 16px; } .publication-year { display: flex; gap: 16px; align-items: baseline; } .pub-figure { display: block; width: 100%; } .pub-figure img { height: auto; max-height: 280px; } .publication-copy h2 { font-size: 26px; } .filters { gap: 18px; } }
</style>

<style>.scholar-link { display:inline-flex; align-items:center; justify-content:center; width:44px; min-height:44px; color:var(--color-accent); }</style>
