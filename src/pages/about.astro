---
import { copy } from "../lib/site-copy.mjs";
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---
<BaseLayout title={copy("ui.navigation.about")}>
  <header class="page-intro"><p class="eyebrow">{copy("ui.about.the-person-behind-the-papers")}</p><h1>{copy("ui.about.hi-i-m")} <span class="preserve-case">{copy("ui.about.mark")}</span>.</h1></header>
  <div class="about-layout"><img class="portrait" src="/headshot.jpg" width="576" height="576" alt={copy("ui.footer.mark-orloff")} /><div class="prose"><p>{copy("ui.about.i-m-a-decision-neuroscientist-and")} <span class="preserve-case">{copy("ui.about.ucla")}</span>.</p><p>{copy("ui.about.i-work-with")} <a class="preserve-case" href="https://www.psych.ucla.edu/faculty-page/erie/">{copy("ui.about.erie-boorman")}</a> {copy("ui.about.in-the-learning-and-decision-making")}</p><p>{copy("ui.about.i-m-interested-in-how-people")}</p><p>{copy("ui.about.reach-me-at")} <a href={`mailto:${SITE.author.email}`}>{copy("contact.email")}</a>.</p><a class="arrow-link" href="/cv">{copy("ui.about.my-cv")} <span aria-hidden="true">→</span></a></div></div>
</BaseLayout>
<style>
  .about-layout { display: grid; grid-template-columns: minmax(0,.65fr) minmax(0,1fr); gap: clamp(32px,6vw,80px); align-items: start; }
  .portrait { width: 100%; max-width: 330px; border-radius: 34% / 28%; border: 2px solid var(--color-accent-2); }
  .prose { padding-top: 14px; }
  .prose a { overflow-wrap: anywhere; }
  @media (max-width: 640px) { .about-layout { grid-template-columns: 1fr; } .portrait { max-width: 230px; } }
</style>
