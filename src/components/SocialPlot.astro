---
import { copy } from "../lib/site-copy.mjs";
import data from '../data/social-conformity.json';
import { plotLayout, plotMarkup, participantLabel } from '../lib/social-plot.mjs';
import '../styles/paper-plots.css';
const { compact = false, id = 'social-plot' } = Astro.props;
---
<social-plot data-story-plot id={id} data-compact={String(compact)} data-view="groups" data-emphasis="all">
  <div class="fog-game" data-fog-game hidden>
    <h4 tabindex="-1" data-fog-prompt></h4>
    <div class="peer-players" data-fog-players></div>
    <div class="value-options fog-options" role="group" aria-label={copy("ui.fog-game.options")}>
      {[0,1].map(i=><button type="button" class="value-option fog-option" data-fog-choice={i}>
        <span class="option-label" data-fog-color></span>
        <span class="option-offer fog-blur"><i class="chance-pie" aria-hidden="true"></i><span class="option-numbers"><span><strong data-fog-amount></strong><small>{copy("ui.value-map.amount-label")}</small></span><span><strong data-fog-chance></strong><small>{copy("ui.value-map.chance-label")}</small></span></span></span>
        <span class="option-zero fog-unreadable">{copy("ui.fog-game.unreadable")}</span>
        <span class="gamble-peers" data-fog-peers></span>
        <span class="option-action">{copy("ui.value-map.choose-this")}</span>
      </button>)}
    </div>
    <p class="game-response" data-fog-response role="status"></p>
    <button type="button" class="quiet-button" data-fog-reset hidden>{copy("ui.peer-game.play-again")}</button>
  </div>
  <figure>
    <div class="plot-heading">
      <div><h3>{copy("ui.social-plot.following-other-people-s-choices")}</h3></div>
      <span class="figure-reference">{copy("ui.social-plot.fig-3a")}</span>
    </div>
    <div class="plot-switch" role="group" aria-label={copy("ui.social-plot.plot-view")} hidden data-enhanced>
      <button type="button" data-view-button="groups" aria-pressed="true">{copy("ui.social-plot.compare-groups")}</button>
      <button type="button" data-view-button="relationship" aria-pressed="false">{copy("ui.social-plot.see-the-relationship")}</button>
    </div>
    <div class="plot-paper">
      <p class="axis-label">{copy("ui.social-plot.following-weight")} <span>{copy("ui.social-plot.higher-more-reliance-on-following")}</span></p>
      <div class="plot-canvas" set:html={plotMarkup(plotLayout(data, 520, 'groups', compact), `${id}-clip`)} />
      <p class="x-axis-label" hidden>{copy("ui.social-plot.solo-utility-model-mismatch")} <span>{copy("ui.social-plot.higher-worse-fit")}</span></p>
    </div>
    <div class="plot-groups" role="group" aria-label={copy("ui.social-plot.highlight-a-participant-group")} hidden data-enhanced>
      <button type="button" data-group="all" aria-pressed="true">{copy("ui.social-plot.all")}</button>
      <button type="button" data-group="control" aria-pressed="false"><span class="group-mark control" aria-hidden="true">●</span> {copy("ui.social-plot.healthy-adults")}</button>
      <button type="button" data-group="insula" aria-pressed="false"><span class="group-mark insula" aria-hidden="true">●</span> {copy("ui.social-plot.insula")}</button>
      <button type="button" data-group="acc" aria-pressed="false"><span class="group-mark acc" aria-hidden="true">●</span> <span class="preserve-case">{copy("ui.social-plot.dacc")}</span></button>
    </div>
    <div class="point-inspector" hidden data-enhanced>
      <p class="point-readout" aria-live="polite" aria-atomic="true"></p>
      <button class="clear-person" type="button" data-clear aria-label={copy("ui.social-plot.clear-selected-participant")} hidden>{copy("ui.social-plot.clear")}</button>
    </div>
    <figcaption>
      <span data-plot-caption>{copy("ui.social-plot.each-colored-dot-is-a-person")}</span>
      <span class="plot-source">{copy("ui.social-plot.redrawn-from")} <a class="text-link preserve-case" href="https://doi.org/10.1371/journal.pcbi.1012602">{copy("ui.social-plot.orloff-et-al-2024")}</a> · <a class="text-link" href="https://code.vt.edu/maorloff/insula-lesions-and-social-heuristic">{copy("ui.social-plot.data-code")}</a></span>
    </figcaption>
  </figure>
  {!compact && <details class="data-table"><summary>{copy("ui.peer-plot.see-the-plotted-values")}</summary><label class="inspect-label" hidden data-enhanced>{copy("ui.social-plot.highlight-a-participant")}<select data-inspect><option value="">{copy("ui.social-plot.choose-a-participant")}</option>{data.participants.map(p => <option value={p.id}>{participantLabel(p)}</option>)}</select></label><p class="muted">{copy("ui.social-plot.anonymous-display-labels-weights-are-posterior")}</p><div class="table-scroll"><table><caption class="sr-only">{copy("ui.social-plot.participant-estimates-underlying-the-interactive-plot")}</caption><thead><tr><th scope="col">{copy("ui.social-plot.participant")}</th><th scope="col">{copy("ui.social-plot.following-weight")}</th><th scope="col">{copy("ui.social-plot.solo-mismatch-log-likelihood")}</th></tr></thead><tbody>{data.participants.map(p => <tr><th scope="row">{participantLabel(p)}</th><td>{p.follow.toFixed(3)}</td><td>{p.soloNll.toFixed(3)}</td></tr>)}</tbody></table></div></details>}
</social-plot>
<script>
  import '../scripts/social-plot';
</script>
<style is:global>
  social-plot { display: block; min-width: 0; --plot-control: var(--color-accent); --plot-insula: var(--color-accent-2); --plot-acc: var(--color-chart-third); }
  social-plot .plot-heading { display: flex; justify-content: space-between; gap: 12px; align-items: start; }
  social-plot .plot-heading .eyebrow { margin-bottom: 10px; }
  social-plot .plot-heading h3 { font-size: 20px; margin-bottom: 18px; }
  social-plot .figure-reference { display: none; }
  social-plot .plot-switch { display: flex; gap: 20px; border-bottom: 1px solid var(--color-line); margin-bottom: 22px; }
  social-plot .plot-switch button { background: none; border: 0; border-bottom: 2px solid transparent; padding: 10px 0; font-size: 12px; min-height: 44px; color: var(--color-muted); }
  social-plot .plot-switch button[aria-pressed="true"] { border-bottom-color: var(--color-accent); color: var(--color-fg); }
  social-plot .plot-paper { color: var(--color-fg); padding: 0 0 14px; }
  social-plot .axis-label, social-plot .x-axis-label { margin: 0; font-size: 12px; line-height: 1.5; padding-inline: 10px; color: var(--color-muted); }
  social-plot .axis-label span, social-plot .x-axis-label span { color: var(--color-muted); display: block; font-size: 11px; }
  social-plot .x-axis-label { text-align: center; margin: -14px 0 0; }
  social-plot .plot-canvas { width: 100%; position: relative; }
  social-plot .participant-plot { display: block; width: 100%; height: auto; overflow: visible; touch-action: pan-y; }
  social-plot .participant-plot text { fill: var(--color-fg); font: 13px var(--font-sans); text-transform: none; }
  social-plot .participant-plot .numeric-tick { font-size: 11px; fill: var(--color-muted); }
  social-plot .participant-plot .plot-n { fill: var(--color-muted); font-size: 11px; }
  social-plot .plot-spine { stroke: var(--color-line); stroke-width: 1; fill: none; }
  social-plot .plot-means { transition: opacity 220ms; }
  social-plot .plot-means line { stroke: var(--color-fg); stroke-width: 1.5; }
  social-plot .plot-means circle { fill: var(--color-muted); stroke: var(--color-fg); stroke-width: 1.5; }
  social-plot .plot-fit { stroke: var(--color-accent); stroke-width: 2; fill: none; opacity: 0; transition: opacity 220ms; }
  social-plot[data-view="relationship"] .plot-fit { opacity: 1; }
  social-plot .plot-dot { transition: opacity 180ms; cursor: pointer; }
  social-plot[data-animate="true"] .plot-dot { transition: transform 500ms cubic-bezier(.2,.65,.2,1), opacity 180ms; }
  social-plot .plot-dot > :first-child { fill: inherit; stroke: var(--color-bg); stroke-width: 1.2; }
  social-plot .group-control { fill: var(--plot-control); }
  social-plot .group-insula { fill: var(--plot-insula); }
  social-plot .group-acc { fill: var(--plot-acc); }
  social-plot .selection-ring { fill: none; stroke: var(--color-fg); stroke-width: 1.5; opacity: 0; }
  social-plot .plot-dot.is-selected .selection-ring { opacity: 1; }
  social-plot [data-dimmed="true"] { opacity: .2; }
  social-plot[data-emphasis="people"] .plot-means { opacity: .65; }
  social-plot[data-view="relationship"] .plot-means { opacity: 0; pointer-events: none; }
  social-plot .plot-groups { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 8px 0; }
  social-plot .plot-groups button { border: none; border-bottom: 1px solid transparent; background: transparent; padding: 5px 0; min-height: 40px; font-size: 12px; color: var(--color-muted); }
  social-plot .plot-groups button[aria-pressed="true"] { color: var(--color-fg); border-bottom-color: var(--color-fg); }
  social-plot .group-mark { margin-right: 4px; font-size: 11px; }
  social-plot .control { color: var(--plot-control); }
  social-plot .insula { color: var(--plot-insula); }
  social-plot .acc { color: var(--plot-acc); }
  social-plot .point-inspector { border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); display: flex; align-items: center; justify-content: space-between; min-height: 63px; gap: 8px; }
  social-plot .point-readout { margin: 8px 0; font-size: 12px; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  social-plot .clear-person { flex: 0 0 auto; min-height: 44px; border: 0; background: none; font-size: 12px; color: var(--color-accent); }
  social-plot .inspect-label { display: block; margin-block: 12px; }
  social-plot .inspect-label select { display: block; margin-top: 8px; width: 100%; color: var(--color-fg); border: 1px solid var(--color-line); background: var(--color-surface); padding: 10px; font-size: 16px; }
  social-plot figcaption { font-size: 11px; line-height: 1.65; color: var(--color-muted); padding-top: 15px; }
  social-plot .plot-source { display: block; margin-top: 5px; }
  social-plot .data-table { margin-top: 24px; font-size: 12px; }
  social-plot .table-scroll { overflow-x: auto; }
  social-plot table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  social-plot th, social-plot td { text-align: right; border-bottom: 1px solid var(--color-line); padding: 10px 8px; font-weight: 400; }
  social-plot th:first-child { text-align: left; padding-left: 0; }
  @media (max-width: 400px) { social-plot .plot-switch { gap: 14px; } social-plot .participant-plot text { font-size: 12px; } social-plot .participant-plot .numeric-tick { font-size: 16px; } }
  @media (pointer: coarse) { social-plot .plot-groups button { min-height: 44px; } }
  @media print { social-plot [data-enhanced] { display: none !important; } social-plot .plot-dot { opacity: 1; } }
</style>
