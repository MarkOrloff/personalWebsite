---
import { copy } from "../lib/site-copy.mjs";
import { NAV_ITEMS } from '../data/navigation';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<nav class="site-nav lowercase-all" aria-label={copy("ui.nav.main-navigation")}>
  <div class="nav-inner">
    <a class="wordmark" href="/" aria-label={copy("ui.nav.mark-orloff-home")}>
      <img src="/headshot.jpg" alt="" width="40" height="40" />
      <span>{copy("ui.nav.mark-orloff")}<span class="name-dot">.</span></span>
    </a>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label={copy("ui.theme.to-dark")} data-to-light={copy("ui.theme.to-light")} data-to-dark={copy("ui.theme.to-dark")}>
      <svg class="theme-icon theme-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
      <svg class="theme-icon theme-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    </button>
    <ul>
      {NAV_ITEMS.map(item => <li><a href={item.href} aria-current={(currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href + '/'))) ? 'page' : undefined}>{item.label}</a></li>)}
    </ul>
  </div>
</nav>
<style>
  .site-nav { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--color-bg) 94%, transparent); border-bottom: 1px solid var(--color-line); backdrop-filter: blur(12px); }
  .nav-inner { max-width: var(--container); margin: auto; padding: 16px var(--gutter); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .wordmark { display: flex; align-items: center; gap: 12px; font-size: 18px; letter-spacing: -.04em; white-space: nowrap; }
  .wordmark img { border-radius: 35%; border: 1px solid var(--color-accent-2); }
  .name-dot { color: var(--color-accent-2); }
  ul { display: flex; list-style: none; gap: 22px; padding: 0; margin: 0 0 0 auto; }
  .theme-toggle { order: 3; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-left: -8px; background: none; border: 0; border-radius: 50%; color: var(--color-muted); cursor: pointer; }
  .theme-toggle:hover { color: var(--color-fg); background: var(--color-surface); }
  li a { display: flex; align-items: center; min-height: 44px; font-size: 13px; color: var(--color-muted); border-bottom: 1px solid transparent; }
  li a[aria-current] { color: var(--color-fg); border-bottom-color: var(--color-accent-2); }
  @media (max-width: 700px) {
    .nav-inner { flex-wrap: wrap; gap: 8px; padding-top: 10px; padding-bottom: 0; }
    .wordmark { font-size: 17px; }
    .wordmark img { width: 32px; height: 32px; }
    ul { width: 100%; justify-content: space-between; gap: 10px; margin: 0; order: 4; }
    .theme-toggle { margin-left: auto; }
    li a { font-size: 12px; }
  }
</style>
