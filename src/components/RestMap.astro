---
import { copy } from '../lib/site-copy';
import { replayPolicies } from '../lib/replay-demo.mjs';
import { restLayout, restSVG } from '../lib/paper-plots.mjs';
import '../styles/paper-plots.css';
---
<rest-map class="paper-plot" data-story-plot data-view="pieces" data-deep-view="map">
  <figure>
    <h3>{copy("ui.rest-map.from-separate-experiences-to-a-shared")}</h3>
    <div data-replay-rules hidden>{Object.keys(replayPolicies).map(key=><p data-replay-rule-text={key}>{copy(`replay.${key}.description`)}</p>)}</div>
    <div data-replay-controls hidden>
      <p class="chart-small">{copy('replay.intro')}</p>
      <div class="replay-policies" role="group" aria-label={copy("ui.rest-map.replay-selection-rule")}>{Object.entries(replayPolicies).map(([key,policy])=><button class="quiet-button" type="button" data-replay-policy={key} aria-pressed={String(key==='broad')}>{policy.label}</button>)}</div>
      <p class="chart-small" data-replay-rule>{copy('replay.broad.description')}</p>
      <div class="replay-actions"><button class="quiet-button" type="button" data-replay-run>{copy("ui.rest-map.simulate-12-replays")}</button><button class="text-button" type="button" data-replay-reset>{copy("ui.rest-map.reset-map")}</button></div>
      <p class="eyebrow" data-replay-count role="status">{copy("ui.rest-map.0-simulated-replays")}</p>
    </div>
    <div class="replay-key" data-replay-key hidden>
      <span><i class="replay-key-thin" aria-hidden="true"></i>{copy('replay.key.thin')}</span>
      <span><i class="replay-key-thick" aria-hidden="true"></i>{copy('replay.key.thick')}</span>
    </div>
    <p class="replay-moment" data-replay-moment hidden aria-live="polite"></p>
    <div class="chart-canvas" set:html={restSVG(restLayout())} />
    <div class="replay-grid" data-replay-grid hidden>{Object.entries(replayPolicies).map(([key,policy])=><figure class="replay-mini" data-mini={key}><p class="mini-name">{policy.label}</p><div class="mini-map" data-mini-map></div><p class="mini-note">{copy(`replay.${key}.compare`)}</p></figure>)}</div>
    <div class="chart-controls inference-controls" role="group" aria-label={copy("ui.rest-map.how-to-connect-the-options")} hidden data-inference-controls><button type="button" data-inference-mode="map" aria-pressed="true">{copy("ui.rest-map.use-the-map")}</button><button type="button" data-inference-mode="memory" aria-pressed="false">{copy("ui.rest-map.recall-the-learned-links")}</button></div>
    <p class="replay-preparation" data-rest-preparation hidden aria-live="polite"></p>
    <p class="chart-readout" data-rest-readout aria-live="polite">{copy("ui.rest-map.each-row-ranks-the-same-four")}</p>
    <figcaption>{copy("ui.rest-map.conceptual-animation-of-combining-relationships-and")}<br />{copy("ui.rest-map.inspired-by-the-question-discussed-in")} <a class="text-link preserve-case" href="https://doi.org/10.1016/j.neuron.2025.10.016">{copy("ui.rest-map.orloff-boorman-2025")}</a>.</figcaption>
  </figure>
</rest-map>
<script>import '../scripts/paper-plots';</script>
