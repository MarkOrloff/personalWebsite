---
// Compact 3D view of one explorer region (see src/scripts/brain-region.ts). No buttons: drag or arrow keys rotate.
import { copy } from '../lib/site-copy.mjs';
import { favoriteRegions } from '../data/brain-explorer';
interface Props { region:string; label:string; hemisphere?:'left'|'right'; zoom?:number; }
const { region, label, hemisphere='left', zoom=1.4 } = Astro.props;
const entry = favoriteRegions.find(r=>r.id===region);
if (!entry) throw new Error(`Unknown brain region: ${region}`);
const config = { id:entry.id, color:entry.color, yaw:entry.yaw, pitch:entry.pitch };
---
<brain-region class="brain-region" data-hemisphere={hemisphere} data-default-zoom={zoom} data-lazy>
  <script type="application/json" data-region-config set:html={JSON.stringify(config)} />
  <canvas tabindex="0" role="img" aria-label={label}></canvas>
  <p class="sr-only" data-brain-loading role="status">{copy('explorer.loading')}</p>
  <p class="brain-region-error" data-brain-error hidden>{copy('brain-region.error')}</p>
</brain-region>
<script>import '../scripts/brain-region';</script>
<style>
brain-region { display:block; position:relative; width:100%; aspect-ratio:1.45; }
canvas { width:100%; height:100%; display:block; cursor:grab; touch-action:pan-y; }
canvas:active { cursor:grabbing; }
canvas:focus-visible { outline:1px solid var(--color-accent); outline-offset:2px; }
.brain-region-error { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; text-align:center; margin:0; font-size:11px; color:var(--color-muted); }
</style>
