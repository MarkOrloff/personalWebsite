---
import { copy } from "../lib/site-copy.mjs";
import { brainEvidence } from '../data/brain-evidence';
interface Props { slug:keyof typeof brainEvidence; compact?:boolean; }
const {slug,compact=false}=Astro.props;
const evidence=brainEvidence[slug];
const crop='crop' in evidence?evidence.crop:undefined;
const rotate='rotate' in evidence&&evidence.rotate;
---
<section class:list={['brain-evidence',{'brain-compact':compact}]} id={`brain-${slug}`} aria-labelledby={`brain-heading-${slug}`}>
  <header class="brain-heading preserve-case">
    <p class="section-label">{copy("ui.brain-evidence.the-brain-evidence")}</p><h2 id={`brain-heading-${slug}`}>{evidence.title}</h2><p>{evidence.intro}</p>
  </header>
  <figure>
    <div class="brain-visual-row">
      <a class="paper-figure-frame" href={evidence.href} aria-label={copy("ui.brain-evidence.read-the-original-study-and-figure")}>
        {crop?<svg viewBox={crop} role="img" aria-label={evidence.alt} class="brain-source-image"><image href={evidence.image} width={evidence.width} height={evidence.height} transform={rotate?'translate(623 0) rotate(90)':undefined} /></svg>:<img src={evidence.image} width={evidence.width} height={evidence.height} alt={evidence.alt} loading="lazy" />}
      </a>
      <figcaption class="brain-key preserve-case">
        <p class="brain-measure">{evidence.measure}</p><p>{evidence.caption}</p>
        <div class="brain-regions">{evidence.regions.map(region=><div><h3>{region.name}</h3><p>{region.role}</p></div>)}</div>
      </figcaption>
    </div>
    <details class="brain-details"><summary>{copy("ui.brain-evidence.more-about-the-brain-result")}</summary>{evidence.regions.map(region=><p class="preserve-case">{region.finding}</p>)}<p class="small-note preserve-case">{evidence.caveat}</p></details>
    <div class="brain-source-links"><a class="text-link preserve-case brain-credit" href={evidence.href}>{evidence.credit} {copy("ui.brain-evidence.original-study")}</a>{evidence.links.map(link=><a class="text-link" href={link.href}>{link.label} ↗</a>)}</div>
    {compact&&slug==='subjective-value'&&<details><summary>{copy("ui.brain-evidence.see-the-complete-brain-data-figure")}</summary><a class="paper-figure-frame" href={evidence.image}><img src={evidence.image} width={evidence.width} height={evidence.height} loading="lazy" alt={copy("ui.brain-evidence.complete-figure-3-with-brain-maps")} /></a></details>}
  </figure>
</section>
<style>
.brain-evidence { margin-top:56px; padding-top:32px; border-top:1px solid var(--color-line); scroll-margin-top:110px; }
.brain-heading { max-width:760px; }
.brain-heading h2 { font:400 clamp(27px,3vw,36px)/1.15 var(--font-editorial); margin:16px 0; }
.brain-heading > p:last-child { font-size:15px; color:var(--color-muted); margin-bottom:24px; }
.brain-visual-row { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(220px,.8fr); align-items:start; gap:clamp(20px,3vw,40px); }
.brain-visual-row > a { width:100%; }
.brain-source-image { display:block; width:100%; height:auto; }
.brain-key { font-size:13px; color:var(--color-muted); margin:0; }
.brain-key p { margin:0 0 16px; }
.brain-measure { color:var(--color-accent); font:11px/1.6 var(--font-mono); }
.brain-regions > div { border-top:1px solid var(--color-line); padding-top:14px; }
.brain-regions h3 { font-size:13px; color:var(--color-fg); margin:0 0 8px; font-weight:500; }
.brain-details { margin-top:18px; font-size:13px; }
.brain-source-links { display:flex; flex-wrap:wrap; gap:8px 20px; margin:18px 0; font-size:11px; }
.brain-compact { margin:0; padding:0; border:0; }
.brain-compact .brain-heading h2,.brain-compact .brain-heading .section-label { display:none; }
.brain-compact .brain-heading > p:last-child { font-size:13px; margin:0 0 18px; }
.brain-compact .brain-visual-row { grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:16px; }
.brain-compact .brain-key { font-size:12px; line-height:1.6; }
.brain-compact .brain-key p { margin-bottom:12px; }
.brain-compact .brain-measure { font-size:10px; }
.brain-compact .brain-regions h3 { font-size:12px; margin-bottom:6px; }
.brain-compact .brain-regions > div { padding-top:10px; }
.brain-compact .brain-details { font-size:12px; margin-top:14px; }
@media(max-width:600px) { .brain-visual-row { grid-template-columns:1fr; gap:20px; } .brain-compact .brain-visual-row { grid-template-columns:1fr; } .brain-compact .brain-visual-row > a { max-width:310px; margin:auto; } .brain-compact .brain-key { font-size:12px; } .brain-regions { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:18px; } }
</style>
