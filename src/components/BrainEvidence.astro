---
import { copy } from "../lib/site-copy.mjs";
import { brainEvidence } from '../data/brain-evidence';
import BrainMap from './BrainMap.astro';
interface Props { slug:keyof typeof brainEvidence; compact?:boolean; }
const {slug,compact=false}=Astro.props;
const evidence=brainEvidence[slug];
const crop='crop' in evidence?evidence.crop:undefined;
const rotate='rotate' in evidence&&evidence.rotate;
// Walkthroughs with a 3D group map show it first; the paper figure stays one click away.
const map='map' in evidence?evidence.map:undefined;
// A figure can instead be split into larger stacked pieces (viewBox crops of the same image).
const panels='panels' in evidence?evidence.panels:undefined;
const panelScale='panelScale' in evidence?evidence.panelScale:undefined;
const widest=panels?Math.max(...panels.flatMap(p=>p.crops.map(c=>Number(c.split(' ')[2])))):1;
const pieceWidth=(crop:string)=>`width:${(Number(crop.split(' ')[2])/widest*100).toFixed(2)}%`;
---
<section class:list={['brain-evidence',{'brain-compact':compact,'brain-with-map':map,'brain-stacked':panels}]} id={`brain-${slug}`} aria-labelledby={`brain-heading-${slug}`}>
  <header class="brain-heading preserve-case">
    <p class="section-label">{copy("ui.brain-evidence.the-brain-evidence")}</p><h2 id={`brain-heading-${slug}`}>{evidence.title}</h2><p>{evidence.intro}</p>
  </header>
  <figure>
    <div class="brain-visual-row">
      {map?<div class="brain-map-column">
        <BrainMap {...map} />
        <details class="brain-original"><summary>{copy("ui.paper-reader.see-the-original-figure")}</summary>
          <a class="paper-figure-frame" href={evidence.href} aria-label={copy("ui.brain-evidence.read-the-original-study-and-figure")}><svg viewBox={crop} role="img" aria-label={evidence.alt} class="brain-source-image"><image href={evidence.image} width={evidence.width} height={evidence.height} /></svg></a>
          <p class="preserve-case">{evidence.caption}</p>
        </details>
      </div>:panels?<a class="paper-figure-frame lesion-panels" href={evidence.href} role="img" aria-label={evidence.alt}>
        {panels.map(panel=><div class="lesion-group"><p class="lesion-label">{panel.label}</p>{panel.crops.map(crop=><svg viewBox={crop} style={pieceWidth(crop)} aria-hidden="true"><image href={evidence.image} width={evidence.width} height={evidence.height} /></svg>)}</div>)}
        {panelScale&&<svg viewBox={panelScale} style={pieceWidth(panelScale)} class="lesion-scale" aria-hidden="true"><image href={evidence.image} width={evidence.width} height={evidence.height} /></svg>}
      </a>:<a class="paper-figure-frame" href={evidence.href} aria-label={copy("ui.brain-evidence.read-the-original-study-and-figure")}>
        {crop?<svg viewBox={crop} role="img" aria-label={evidence.alt} class="brain-source-image"><image href={evidence.image} width={evidence.width} height={evidence.height} transform={rotate?'translate(623 0) rotate(90)':undefined} /></svg>:<img src={evidence.image} width={evidence.width} height={evidence.height} alt={evidence.alt} loading="lazy" />}
      </a>}
      <figcaption class="brain-key preserve-case">
        <p class="brain-measure">{evidence.measure}</p>{!map&&<p>{evidence.caption}</p>}
        <div class="brain-regions">{evidence.regions.map(region=><div><h3>{map&&'outline' in region?<button type="button" class="region-outline" data-outline={region.outline} aria-pressed="false">{region.name}</button>:region.name}</h3><p>{region.role}</p></div>)}</div>
      </figcaption>
    </div>
    <details class="brain-details"><summary>{copy("ui.brain-evidence.more-about-the-brain-result")}</summary>{evidence.regions.map(region=>region.finding&&<p class="preserve-case">{region.finding}</p>)}</details>
    <div class="brain-source-links"><a class="text-link preserve-case brain-credit" href={evidence.href}>{evidence.credit} {copy("ui.brain-evidence.original-study")}</a>{evidence.links.map(link=><a class="text-link" href={link.href}>{link.label} ↗</a>)}</div>
    {compact&&slug==='subjective-value'&&<details><summary>{copy("ui.brain-evidence.see-the-complete-brain-data-figure")}</summary><a class="paper-figure-frame" href={evidence.image}><img src={evidence.image} width={evidence.width} height={evidence.height} loading="lazy" alt={copy("ui.brain-evidence.complete-figure-3-with-brain-maps")} /></a></details>}
  </figure>
</section>
<style>
.brain-evidence { margin-top:56px; padding-top:32px; border-top:1px solid var(--color-line); scroll-margin-top:110px; }
.brain-heading { max-width:760px; }
.brain-heading h2 { font:400 clamp(27px,3vw,36px)/1.15 var(--font-editorial); margin:16px 0; }
.brain-heading > p:last-child { font-size:15px; color:var(--color-muted); margin-bottom:24px; }
.brain-visual-row { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(220px,.8fr); align-items:start; gap:clamp(20px,3vw,40px); }
.brain-visual-row > a { width:100%; }
.brain-source-image { display:block; width:100%; height:auto; }
.brain-key { font-size:13px; color:var(--color-muted); margin:0; }
.brain-key p { margin:0 0 16px; }
.brain-measure { color:var(--color-accent); font:11px/1.6 var(--font-mono); }
.brain-regions > div { border-top:1px solid var(--color-line); padding-top:14px; }
.brain-regions h3 { font-size:13px; color:var(--color-fg); margin:0 0 8px; font-weight:500; }
.region-outline { all:unset; cursor:pointer; text-decoration:underline dotted; text-underline-offset:3px; }
.region-outline:hover,.region-outline[aria-pressed="true"] { text-decoration:underline solid; text-decoration-thickness:2px; }
.region-outline:focus-visible { outline:1px solid var(--color-accent); outline-offset:2px; }
.brain-details { margin-top:18px; font-size:13px; }
.brain-source-links { display:flex; flex-wrap:wrap; gap:8px 20px; margin:18px 0; font-size:11px; }
.brain-compact { margin:0; padding:0; border:0; }
.brain-compact .brain-heading h2,.brain-compact .brain-heading .section-label { display:none; }
.brain-compact .brain-heading > p:last-child { font-size:13px; margin:0 0 18px; }
.brain-compact .brain-visual-row { grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:16px; }
.brain-compact .brain-key { font-size:12px; line-height:1.6; }
.brain-compact .brain-key p { margin-bottom:12px; }
.brain-compact .brain-measure { font-size:10px; }
.brain-compact .brain-regions h3 { font-size:12px; margin-bottom:6px; }
.brain-stacked .brain-visual-row,.brain-compact.brain-stacked .brain-visual-row { grid-template-columns:1fr; }
.lesion-panels { display:block; padding:14px 12px; background:#fff; }
.lesion-panels svg { display:block; height:auto; margin-bottom:6px; }
.lesion-group + .lesion-group { margin-top:14px; }
.lesion-label { font:11px/1.5 var(--font-mono); color:#38404a; margin:0 0 6px; }
.lesion-scale { margin:12px auto 0; }
.brain-compact .brain-regions > div { padding-top:10px; }
.brain-compact .brain-details { font-size:12px; margin-top:14px; }
.brain-with-map .brain-visual-row,.brain-compact.brain-with-map .brain-visual-row { grid-template-columns:1fr; gap:14px; }
.brain-with-map .brain-regions { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px; }
.brain-map-column { min-width:0; }
.brain-original { font-size:12px; margin-top:4px; }
.brain-original .paper-figure-frame { display:block; max-width:360px; margin:12px 0 10px; }
.brain-original p { color:var(--color-muted); line-height:1.6; margin:0; }
@media(max-width:600px) { .brain-visual-row { grid-template-columns:1fr; gap:20px; } .brain-compact .brain-visual-row { grid-template-columns:1fr; } .brain-compact .brain-visual-row > a { max-width:310px; margin:auto; } .brain-compact .brain-key { font-size:12px; } .brain-regions { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:18px; } }
</style>
