---
import { copy } from "../lib/site-copy.mjs";
import BrainEvidence from './BrainEvidence.astro';
import { fillValueCopy } from '../lib/value-copy.mjs';
import type { PaperStory } from '../data/paper-stories';
import type { CollectionEntry } from 'astro:content';
import '../styles/publication-reader.css';
interface Props { story: PaperStory; paper: CollectionEntry<'publications'>['data']; }
const { story, paper } = Astro.props;
const figures = story.figures || (paper.figure ? [{src:paper.figure,width:paper.figureWidth!,height:paper.figureHeight!,alt:paper.figureAlt || '',caption:paper.type==='commentary'?copy("ui.paper-reader.figure-from-our-commentary"):copy("ui.paper-reader.figure-2a-valuation-related-responses-to")}] : []);
---
<article class="publication-reader preserve-case" data-reader data-paper={story.slug}>
  <header class="reader-header"><a class="back-link text-link" href="/publications">{copy("ui.paper-reader.all-publications")}</a><p class="eyebrow preserve-case">{story.category}</p><h1>{story.title}</h1><p class="reader-deck">{story.deck}</p>{paper.status==='preprint'&&<p class="preprint-label">{copy("ui.paper-reader.preprint-may-2026-not-yet-peer")}</p>}</header>
  {paper.type==='commentary'&&<aside class="original-study-credit preserve-case"><p class="section-label">{copy("ui.paper-reader.the-original-research")}</p><p>{story.originalStudy!.authors}</p><a class="text-link" href={story.originalStudy!.href}>{story.originalStudy!.title} ↗</a><p class="small-note">{copy("ui.paper-reader.this-walkthrough-discusses-their-experiment-and")}</p></aside>}
  <div class="reader-toolbar" hidden data-enhanced>
    <div class="depth-tabs" role="tablist" aria-label={copy("ui.paper-reader.reading-depth")}>
      <button type="button" role="tab" id="depth-gist" aria-controls="panel-gist" aria-selected="true" data-depth="gist">{copy("ui.paper-reader.the-gist")} <span>{copy("ui.paper-reader.30-seconds")}</span></button>
      <button type="button" role="tab" id="depth-story" aria-controls="panel-story" aria-selected="false" tabindex="-1" data-depth="story">{copy("ui.paper-reader.walk-me-through-it")} <span>{story.slug==='subjective-value'?copy("ui.paper-reader.5-minutes"):copy("ui.paper-reader.3-minutes")}</span></button>
      <button type="button" role="tab" id="depth-deep" aria-controls="panel-deep" aria-selected="false" tabindex="-1" data-depth="deep">{copy("ui.paper-reader.go-deeper")} <span>{copy("ui.paper-reader.another-layer")}</span></button>
    </div>
    <button class="share-button" type="button" data-share>{copy("ui.paper-reader.copy-reading-link")}</button><p class="share-status sr-only" role="status"></p><label class="share-fallback" hidden>{copy("ui.paper-reader.reading-link")} <input readonly aria-label={copy("ui.paper-reader.reading-link")} /></label>
  </div>
  <div class="reader-body">
    <div class="reader-narrative preserve-case">
      <section id="panel-gist" role="tabpanel" aria-labelledby="depth-gist" data-depth-panel="gist"><p class="section-label">{copy("ui.paper-reader.the-short-version")}</p><h2>{story.gistTitle}</h2>{story.gist.map(text=><p>{text}</p>)}<button type="button" class="reader-cta" data-start-story hidden data-enhanced>{copy("ui.paper-reader.explore-the-idea-with-me")} <span aria-hidden="true">→</span></button><p class="small-note">{story.caveat}</p></section>
      <section id="panel-story" role="tabpanel" aria-labelledby="depth-story" data-depth-panel="story">
        <div class="story-copy" aria-live="polite" aria-atomic="true">
          {story.steps.map((step,i)=><div data-step-panel={i} data-view={step.view} data-visual={step.visual || 'plot'} data-emphasis={step.emphasis || 'all'}>
            <h2 class="sr-only">{step.title}</h2>
            <p data-value-template={story.slug==='subjective-value'?step.text:undefined}>{story.slug==='subjective-value'?fillValueCopy(step.text):step.text}</p>
            {step.more&&<p data-value-template={story.slug==='subjective-value'?step.more:undefined}>{story.slug==='subjective-value'?fillValueCopy(step.more):step.more}</p>}
            <p class="step-hint" data-value-template={story.slug==='subjective-value'?step.hint:undefined}>{story.slug==='subjective-value'?fillValueCopy(step.hint):step.hint}</p>
          </div>)}
        </div>
      </section>
      <section id="panel-deep" role="tabpanel" aria-labelledby="depth-deep" data-depth-panel="deep"><p class="section-label">{copy("ui.paper-reader.behind-the")} {copy(paper.type==='commentary'?"label.idea":"label.figure")}</p><h2>{story.deepTitle}</h2>{story.deep.map(text=><p>{text}</p>)}<dl class="findings">{story.findings.map(f=><div><dt>{f.label}</dt><dd class="preserve-case">{f.value}</dd></div>)}</dl><p class="small-note">{story.caveat}</p>{figures.map(fig=><details><summary>{copy("ui.paper-reader.see-the-original-figure")}</summary><figure class="original-figure"><a class="paper-figure-frame" href={fig.src} target="_blank" rel="noopener" aria-label={copy("ui.paper-reader.open-the-original-figure-at-full")}><img src={fig.src} width={fig.width} height={fig.height} loading="lazy" alt={fig.alt} /></a><figcaption>{fig.caption} <a class="text-link" href={fig.src} target="_blank" rel="noopener">{copy("ui.paper-reader.view-full-size")}</a></figcaption></figure></details>)}<a class="arrow-link" href={`https://doi.org/${paper.doi}`}>{copy("ui.paper-reader.read-the-full")} {copy(paper.type==='commentary'?"label.commentary":paper.status==='preprint'?"label.preprint":"label.paper")} <span aria-hidden="true">↗</span></a></section>
    </div>
    <div class="reader-figure">
      <div data-reader-plot><slot name="figure" /></div>
      <div data-reader-brain><BrainEvidence slug={story.slug as 'subjective-value'|'safer-peers'|'smell-and-space'|'maps-at-rest'} compact /></div>
      {paper.type==='commentary'&&paper.figure&&<figure data-reader-commentary class="original-figure story-commentary">
        <a class="paper-figure-frame" href={paper.figure} target="_blank" rel="noopener"><img src={paper.figure} width={paper.figureWidth} height={paper.figureHeight} alt={paper.figureAlt || copy("ui.paper-reader.figure-from-our-commentary.2")} loading="lazy" /></a>
        <figcaption>{copy("ui.paper-reader.from-our-commentary")} <a class="text-link preserve-case" href={`https://doi.org/${paper.doi}`}>{copy("ui.paper-reader.orloff-boorman")} {paper.year} ↗</a></figcaption>
      </figure>}
    </div>
    <div class="story-pagination" hidden data-enhanced><button class="quiet-button" type="button" data-step-previous disabled>{copy("ui.paper-reader.back")}</button><span class="eyebrow" data-step-count></span><button class="quiet-button" type="button" data-step-next>{copy("ui.paper-reader.next")}</button></div>
  </div>
  <aside class="author-note"><div><p class="section-label">{story.takeawayTitle}</p><p class="note-byline">{paper.type==='commentary'?copy("ui.paper-reader.beyond-the-headline-finding"):copy("ui.paper-reader.the-question-behind-the-work")}</p></div><p class="excitement-copy preserve-case">{story.takeaway}</p></aside>
  <footer class="paper-reference"><p class="section-label">{copy("ui.paper-reader.the")} {copy(paper.type==='commentary'?"label.commentary":"label.paper")}</p><div><p class="citation-title preserve-case">{paper.title}</p><p class="citation-authors preserve-case">{paper.authors.join(', ')}.</p><p class="preserve-case muted">{paper.venue} · {paper.year}{paper.authors.some(a=>a.includes('*'))?(" " + copy("ui.paper-reader.equal-contribution")):''}</p><div class="reference-links preserve-case">{story.sources.map(source=><a class="text-link" href={source.href}>{source.label} ↗</a>)}</div></div></footer>
</article>
<script>import '../scripts/publication-reader';</script>
<style>.preprint-label { display: inline-block; color: var(--color-accent); font: 11px/1.5 var(--font-mono); border-left: 2px solid var(--color-accent); padding-left: 12px; margin: -20px 0 32px; }</style>
